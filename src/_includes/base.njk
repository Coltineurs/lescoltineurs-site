<!doctype html>
{%- set t = i18n[langue or "fr"] %}
<html lang="{{ t.langue }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.nom) if title else (site.nom + " · " + t.slogan) %}
  {%- set pageDescription = description or site.description %}
  {%- set canonical = page.url | absolute(site.url) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ t.locale }}">
  {%- if alternate %}
  <link rel="alternate" hreflang="{{ t.langue }}" href="{{ canonical }}">
  <link rel="alternate" hreflang="{{ 'fr' if t.langue == 'en' else 'en' }}" href="{{ alternate | absolute(site.url) }}">
  <link rel="alternate" hreflang="x-default" href="{{ (page.url if t.langue == 'fr' else alternate) | absolute(site.url) }}">
  {%- endif %}
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:title" content="{{ title or site.nom }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ (ogImage or 'salle-interieur.jpg') | imageUrlSync | absolute(site.url) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0E3B2E">
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/fonts/cormorant-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/jost-300-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  {%- if jsonld == "restaurant" %}{% set ld = schema %}{% elif jsonld == "menu" %}{% set ld = menu | menuSchema %}{% elif jsonld == "vins" %}{% set ld = vins | vinsSchema %}{% endif %}
  {% if ld %}<script type="application/ld+json">{{ ld | json | safe }}</script>{% endif %}
</head>
<body class="page-{{ bodyClass or 'interieure' }}">
  <a class="skip" href="#contenu">{{ t.allerContenu }}</a>
  {% if site.annonce %}<p class="annonce">{{ site.annonce }}</p>{% endif %}
  <header class="entete">
    <div class="entete__inner">
      <a class="entete__logo" href="{{ t.accueil }}" aria-label="{{ site.nom }}, {{ t.accueilLabel }}">
        <img src="{{ 'logo.jpg' | imageUrlSync(600) }}" alt="" width="64" height="64">
        <span>Les Coltineurs</span>
      </a>
      <nav class="nav" aria-label="{{ t.navLabel }}">
        <input type="checkbox" id="nav-toggle" class="nav__toggle" aria-hidden="true">
        <label for="nav-toggle" class="nav__burger"><span class="sr">{{ t.ouvrirMenu }}</span><span aria-hidden="true"></span></label>
        <ul class="nav__liste">
          {%- for item in t.navigation %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.titre }}</a></li>
          {%- endfor %}
          <li><a class="nav__langue" href="{{ alternate or t.autreLangue.accueil }}" hreflang="{{ t.autreLangue.code | lower }}" lang="{{ t.autreLangue.code | lower }}" aria-label="{{ t.autreLangue.label }}">{{ t.autreLangue.code }}</a></li>
        </ul>
      </nav>
      <a class="bouton bouton--plein entete__reserver" href="{{ site.zenchef.reserver }}" rel="noopener">{{ t.reserver }}</a>
    </div>
  </header>

  <main id="contenu">
    {{ content | safe }}
  </main>

  <footer class="pied">
    <div class="pied__inner">
      <div class="pied__bloc">
        <p class="pied__nom">Les Coltineurs</p>
        <p>{{ t.pied.presentation | safe }}</p>
      </div>
      <div class="pied__bloc">
        <h2>{{ t.pied.trouver }}</h2>
        <address>
          <a href="{{ site.carte }}" rel="noopener">{{ site.adresse.rue }}<br>{{ site.adresse.codePostal }} {{ site.adresse.ville }}</a><br>
          <a href="tel:{{ site.telephoneIntl }}">{{ site.telephone }}</a>
        </address>
      </div>
      <div class="pied__bloc">
        <h2>{{ t.pied.horaires }}</h2>
        <p>{{ t.pied.horairesTexte | safe }}</p>
      </div>
      <div class="pied__bloc">
        <h2>{{ t.pied.suivre }}</h2>
        <p><a href="{{ site.instagram }}" rel="noopener">Instagram @lescoltineurs</a>
        {%- for l in t.pied.liens %}<br>
        <a href="{{ site.zenchef.reserver if l.url == 'zenchef' else l.url }}"{% if l.url == 'zenchef' %} rel="noopener"{% endif %}>{{ l.titre }}</a>
        {%- endfor %}
        {%- if site.carteCadeau %}<br>
        <a href="{{ site.carteCadeau }}" rel="noopener">{{ "Gift card" if t.langue == "en" else "Offrir une carte cadeau" }}</a>{% endif %}<br>
        <a href="{{ site.homardVolant }}" rel="noopener">{{ t.pied.traiteur }}</a></p>
      </div>
    </div>
    <p class="pied__legal"><a href="/mentions-legales/">{{ t.pied.mentions }}</a> · {% if site.googleAds or site.googleAnalytics %}<button type="button" class="lien" data-consentement="gerer">{{ t.pied.cookies }}</button> · {% endif %} © {{ "now" | annee }} Les Coltineurs</p>
  </footer>
  {%- if site.googleAds or site.googleAnalytics %}
  <div id="consentement" class="consentement" role="dialog" aria-live="polite" aria-label="Cookies" data-google-ads="{{ site.googleAds }}" data-google-analytics="{{ site.googleAnalytics }}" hidden>
    <p>{{ t.consentement.texte }} <a href="/mentions-legales/#cookies">{{ t.consentement.plus }}</a></p>
    <div class="consentement__boutons">
      <button type="button" class="bouton" data-consentement="refuse">{{ t.consentement.refuser }}</button>
      <button type="button" class="bouton" data-consentement="accepte">{{ t.consentement.accepter }}</button>
    </div>
  </div>
  <script src="/js/consentement.js" defer></script>
  {%- endif %}
</body>
</html>
